<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CodexBarWidget: a Windows 11 widget provider that shows AI coding-tool
    quota usage (data fetched by Win-CodexBar's codexbar-cli) on the Widgets board.

    Structure follows Microsoft's official walkthrough
    "Implement a widget provider in a C# Windows App":
    console-style exe + IWidgetProvider + COM class factory, packaged with MSIX.
  -->
  <PropertyGroup>
    <!-- WinExe: no console window flashes when the widget host activates us.
         Diagnostics go to a log file instead (see Log.cs). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CodexBarWidget</RootNamespace>
    <AssemblyName>CodexBarWidget</AssemblyName>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;arm64</Platforms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Bundle the Windows App Runtime into the package so the target machine
         does not need a separate runtime install. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Adaptive Card template ships as a loose file next to the exe so it
         can be tweaked without recompiling. -->
    <Content Include="Templates\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
