<?xml version="1.0" encoding="utf-8"?>
<!--
  Package manifest for AIDexWidget.

  The build script (scripts/02-build.ps1) copies the publish output next to
  this manifest, then packs everything with MakeAppx. The CLSID below must
  match Program.cs (ClsidFactory) in BOTH places it appears:
    1. <com:Class Id="...">
    2. <CreateInstance ClassId="...">
  The Publisher must match the signing certificate subject exactly:
    CN=AIDexWidgetDev
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com rescap">

  <Identity Name="AIDexWidget"
            Publisher="CN=AIDexWidgetDev"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>AIDex Widget</DisplayName>
    <PublisherDisplayName>AIDexWidgetDev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-cn" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="AIDexWidget.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="AIDex Widget"
        Description="在小部件面板查看 AI 编程工具的配额用量"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">
      </uap:VisualElements>

      <Extensions>
        <!-- Packaged COM server: how the widget host activates our exe. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="AIDexWidget.exe" DisplayName="AIDexWidget">
              <com:Class Id="3F5A6FFB-F501-46FD-A614-AE8F40F3B00E" DisplayName="AIDexWidgetProvider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Widget provider registration. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets"
                             DisplayName="AIDexWidget"
                             Id="AIDexWidgetProvider"
                             PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\StoreLogo.png" />
                </ProviderIcons>
                <Activation>
                  <!-- The app exports a COM interface implementing IWidgetProvider -->
                  <CreateInstance ClassId="3F5A6FFB-F501-46FD-A614-AE8F40F3B00E" />
                </Activation>
                <TrustedPackageFamilyNames>
                  <TrustedPackageFamilyName>Microsoft.MicrosoftEdge.Stable_8wekyb3d8bbwe</TrustedPackageFamilyName>
                </TrustedPackageFamilyNames>
                <Definitions>
                  <Definition Id="AI_Usage_Widget"
                              DisplayName="AI 用量"
                              Description="Codex、Claude 等 AI 编程工具的配额用量（数据来自 Nowdex）"
                              AllowMultiple="false">
                    <Capabilities>
                      <Capability><Size Name="small" /></Capability>
                      <Capability><Size Name="medium" /></Capability>
                      <Capability><Size Name="large" /></Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\ProviderAssets\WidgetIcon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\ProviderAssets\WidgetScreenshot.png" DisplayAltText="AI 用量小组件预览" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The provider is a full-trust Win32 process: it must be able to read
         Nowdex's local snapshot files under %LOCALAPPDATA%\Packages. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
